{
  "name": "ichbinhier-staff-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "size": "size-limit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "cd .. && husky .husky || true",
    "check:licenses": "node scripts/check-third-party-licenses.mjs",
    "knip": "knip",
    "knip:production": "knip --production",
    "jscpd": "jscpd"
  },
  "size-limit": [
    {
      "name": "JS",
      "path": "dist/assets/*.js",
      "gzip": true,
      "limit": "340 kB"
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css",
      "gzip": true,
      "limit": "20 kB"
    }
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "^5.102.8",
    "@untitledui/icons": "^0.0.22",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "jsdom": "^29.1.1",
    "knip": "^6.48.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
