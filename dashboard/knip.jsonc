{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // knip --production leaves out the licence script, tests and src/test, so it
  // reports an export that only they read.
  "project": [
    "**/*.{js,mjs,ts,tsx}!",
    "!scripts/**!",
    "!src/test/**!",
    "!src/**/*.test.{ts,tsx}!",
  ],
  // The root .husky/pre-commit runs lint-staged, outside knip's view.
  "ignoreDependencies": ["lint-staged"],
}
