# create .env file with random password before starting
DB_PASSWORD=

# optional — leave empty to log emails instead of sending them (see backend/README.md)
RESEND_API_KEY=
RESEND_FROM=

# one initial password per seeded staff account (A17) — five distinct values,
# only read the first time each account is created (see backend/README.md)
STAFF_1_PASSWORD=
STAFF_2_PASSWORD=
STAFF_3_PASSWORD=
STAFF_4_PASSWORD=
STAFF_5_PASSWORD=

# the demo week of Applications (A21) is seeded by default; set this to an
# empty value for a stack that starts with no Applications at all
# SPRING_PROFILES_ACTIVE=demo

# The Compose demo is opened on the presenting machine at localhost:8081
# (form) and localhost:8082 (dashboard). The dashboard Sign-in cookie stays
# Secure; serve the containers through TLS instead of using a LAN hostname or
# IP address over plain HTTP. Keep the demo database to synthetic test data.
