{
  "name": "ichbinhier-volunteer-form",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "size": "size-limit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "cd .. && husky .husky || true",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:tokens": "node scripts/check-unused-tokens.mjs",
    "check:token-json": "node scripts/check-token-json.mjs",
    "knip": "knip",
    "knip:production": "knip --production",
    "jscpd": "jscpd",
    "check": "npm run typecheck && npm run lint && npm run stylelint && npm run format:check && npm run check:tokens && npm run check:token-json && node ../scripts/check-config-parity.mjs && npm run knip && npm run knip:production && npm run jscpd && npm test -- --coverage"
  },
  "size-limit": [
    {
      "name": "JS",
      "path": "dist/assets/*.js",
      "gzip": true,
      "limit": "110 kB"
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css",
      "gzip": true,
      "limit": "10 kB"
    }
  ],
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.0",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
